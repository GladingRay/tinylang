#ifndef DIAG
#define DIAG(ID, Level, Msg)
#endif

DIAG(err_unterminated_block_comment, Error, "unterminated (* comment")
DIAG(err_unterminated_char_or_string, Error, "missing terminating character")
DIAG(err_hex_digit_in_decimal, Error, "decimal number contains hex digit")
DIAG(err_invalid_real_literal, Error, "invalid real literal")
DIAG(err_longreal_literal_not_implemented, Error, "LONGREAL literals (scale factor D) are not implemented yet")

DIAG(err_expected, Error, "expected {0} but found {1}")
DIAG(err_module_identifier_not_equal, Error, "module identifier at begin and end not equal")
DIAG(note_module_identifier_declaration, Note, "module identifier declared here")
DIAG(err_proc_identifier_not_equal, Error, "procedure identifier at begin and end not equal")
DIAG(note_proc_identifier_declaration, Note, "procedure identifier declared here")

DIAG(err_symbold_declared, Error, "symbol {0} already declared")
DIAG(err_types_for_operator_not_compatible, Error, "types not compatible for operator {0}")
DIAG(err_undeclared_name, Error, "undeclared name {0}")
DIAG(err_if_expr_must_be_bool, Error, "expression of IF statement must have type BOOLEAN")
DIAG(err_while_expr_must_be_bool, Error, "expression of WHILE statement must have type BOOLEAN")
DIAG(err_vardecl_requires_type, Error, "variable declaration requires type")
DIAG(err_typedecl_requires_type, Error, "type declaration requires a type")
DIAG(err_array_bound_not_constant, Error, "array bound must be a constant integer")
DIAG(err_array_bound_invalid, Error, "array bound is invalid (lower bound must not exceed upper bound)")
DIAG(err_array_param_requires_var, Error, "array parameter must be declared as VAR parameter")
DIAG(err_returntype_must_be_type, Error, "return type of function must be declared type")
DIAG(err_function_call_on_nonfunction, Error, "function call requires a function")
DIAG(err_procedure_call_on_nonprocedure, Error, "procedure call requires a procedure")
DIAG(err_indexed_expression_requires_array, Error, "indexed expression requires an array")
DIAG(err_index_expression_must_be_integer, Error, "index expression must have type INTEGER")
DIAG(err_field_access_requires_record, Error, "field access requires a record")
DIAG(err_undeclared_field, Error, "field {0} is not declared in record")
DIAG(err_extended_record_base_must_be_record, Error, "base type of an extended record must be a record")
DIAG(err_field_conflicts_with_base, Error, "field {0} is already declared in the base record")
DIAG(err_receiver_requires_record, Error, "receiver type of a type-bound procedure must be a record")
DIAG(err_duplicate_method, Error, "method {0} is already declared for this record type")
DIAG(err_method_signature_mismatch, Error, "method {0} does not match the signature of its declaration or inherited method")
DIAG(err_undeclared_method, Error, "method {0} is not declared for the receiver type")
DIAG(err_method_call_requires_variable, Error, "method call requires a variable receiver")
DIAG(err_method_call_requires_record, Error, "method call requires a receiver of record type")
DIAG(err_method_requires_receiver, Error, "type-bound procedure {0} requires a receiver")
DIAG(err_method_body_inside_record, Error, "a method body must be defined outside the record, with a receiver")
DIAG(err_method_not_implemented, Error, "method {0} is declared in the record but not implemented")
DIAG(err_type_test_requires_record, Error, "type test requires a variable of a record type")
DIAG(err_type_test_not_extension, Error, "type test requires a type extension of the static type")
DIAG(err_wrong_number_of_parameters, Error, "wrong number of parameters")
DIAG(err_type_of_formal_and_actual_parameter_not_compatible, Error, "type of formal and actual parameter are not compatible")
DIAG(err_var_parameter_requires_var, Error, "VAR parameter requires variable as argument")
DIAG(err_function_requires_return, Error, "Function requires RETURN with value")
DIAG(err_procedure_requires_empty_return, Error, "Procedure does not allow RETURN with value")
DIAG(err_function_and_return_type, Error, "Type of RETURN value is not compatible with function type")

DIAG(err_not_yet_implemented, Error, "module imports are not yet implemented")
#undef DIAG
